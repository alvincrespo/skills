#!/usr/bin/env python3
"""Stand-in for the `gh` CLI, backed by local bare git repos.

Only the calls the harness (and `release_tool.py phase`) make are implemented.
Configured by environment variables:
  FAKE_STATE        directory holding git/<owner>/<repo>.git and prs.json  (required)
  FAKE_GH_SCOPES    value of the X-OAuth-Scopes header     (default "repo, delete_repo")
  FAKE_GH_FAIL      fail any `gh api` call whose path or method contains this text
"""
import json
import os
import shutil
import subprocess
import sys

STATE = os.environ["FAKE_STATE"]
OWNER = "tester"
REPOS = f"{STATE}/git/{OWNER}"
PRS = f"{STATE}/prs.json"


def sh(*cmd, cwd=None):
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, check=True).stdout


def load_prs():
    return json.load(open(PRS)) if os.path.exists(PRS) else []


def parse(argv):
    opts = {"method": "GET", "fields": {}, "path": None, "include_headers": False}
    i = 0
    while i < len(argv):
        t = argv[i]
        if t == "-X":
            opts["method"] = argv[i + 1]; i += 2
        elif t in ("-H", "-q"):
            i += 2
        elif t in ("-f", "-F"):
            k, _, v = argv[i + 1].partition("="); opts["fields"][k] = v; i += 2
        elif t == "-i":
            opts["include_headers"] = True; i += 1
        else:
            opts["path"] = t; i += 1
    return opts


def main():
    args = sys.argv[1:]
    if args[:1] == ["pr"]:          # `gh pr list` from release_tool: no open release PR
        print("")
        return 0
    assert args[0] == "api", args
    o = parse(args[1:])
    path, method = o["path"], o["method"]
    if os.environ.get("FAKE_GH_FAIL") and (os.environ["FAKE_GH_FAIL"] in path
                                           or os.environ["FAKE_GH_FAIL"] == method):
        print(f"fake gh: forced failure for {method} {path}", file=sys.stderr)
        return 1

    if path == "user":
        if o["include_headers"]:
            print("HTTP/2.0 200 OK\nX-Oauth-Scopes: "
                  + os.environ.get("FAKE_GH_SCOPES", "repo, delete_repo") + "\n\n{}")
        else:
            print(OWNER)
        return 0
    if path == "user/repos" and method == "POST":
        name = o["fields"]["name"]
        sh("git", "init", "-q", "--bare", "-b", "main", f"{REPOS}/{name}.git")
        print(json.dumps({"full_name": f"{OWNER}/{name}"}))
        return 0

    name = path.split("?")[0].split("/")[2]
    bare = f"{REPOS}/{name}.git"
    if method == "DELETE":
        shutil.rmtree(bare)
        return 0
    if not os.path.exists(bare):
        print("Not Found", file=sys.stderr)
        return 1

    full = "/".join(path.split("/")[3:])
    rest = full.split("?")[0]
    if rest == "":
        print("{}")
    elif rest == "pulls":
        head = path.split("head=")[1].split(":", 1)[1]
        print(json.dumps([p for p in load_prs() if p["head"]["ref"] == head and p["state"] == "open"]))
    elif rest.startswith("compare/"):
        head = rest.split("...")[1]
        numstat = [l for l in sh("git", "diff", "--numstat", f"main...{head}", cwd=bare).split("\n") if l]
        files = [{"filename": l.split("\t")[2], "additions": int(l.split("\t")[0]),
                  "deletions": int(l.split("\t")[1])} for l in numstat]
        print(json.dumps({"files": files,
                          "ahead_by": int(sh("git", "rev-list", "--count", f"main..{head}", cwd=bare))}))
    elif rest.startswith("contents/"):
        file, _, ref = full[len("contents/"):].partition("?ref=")
        print(sh("git", "show", f"{ref}:{file}", cwd=bare), end="")
    elif rest == "commits":
        print(json.dumps([{"sha": s} for s in sh("git", "log", "--format=%H", "main", cwd=bare).split()]))
    elif rest.startswith("pulls/") and rest.endswith("/merge"):
        number = int(rest.split("/")[1])
        prs = load_prs()
        pr = next(p for p in prs if p["number"] == number)
        work = f"{STATE}/mergework"
        shutil.rmtree(work, ignore_errors=True)
        ident = ("-c", "user.email=fake@example.invalid", "-c", "user.name=fake")
        sh("git", "clone", "-q", bare, work)
        sh("git", *ident, "merge", "--squash", f"origin/{pr['head']['ref']}", cwd=work)
        sh("git", *ident, "commit", "-q", "-m", f"{pr['title']} (#{number})", cwd=work)
        sh("git", "push", "-q", "origin", "main", cwd=work)
        pr["state"] = "closed"
        json.dump(prs, open(PRS, "w"))
        print(json.dumps({"merged": True}))
    else:
        print(f"fake gh: unhandled {path}", file=sys.stderr)
        return 1
    return 0


sys.exit(main())
